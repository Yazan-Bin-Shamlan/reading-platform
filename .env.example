# Copy to .env.local and fill in. Never commit .env.local.
# Variables starting with NEXT_PUBLIC_ are sent to the browser; nothing else is.

# ── Supabase (database, sign-in, file storage) ─ needed from Phase 0 ──────────
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Used for storage uploads and background jobs (Phase 1+).
SUPABASE_SECRET_KEY=sb_secret_...

# Dashboard → Connect → ORMs → Prisma
# Pooled (port 6543, transaction mode) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432) — used only for migrations.
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"

# Show "Continue with Google" on the sign-in page (enable the Google provider in Supabase first).
NEXT_PUBLIC_AUTH_GOOGLE=false

# Largest PDF you can upload, in MB. 50 = Supabase Free's per-file cap; raise it on Pro.
NEXT_PUBLIC_MAX_UPLOAD_MB=50

# ── Smart Reading Assist ─ Phase 3 ───────────────────────────────────────────
# gemini (default). The AI layer is provider-agnostic; others can be added later.
# In local development without a key, a labelled demo provider stands in.
AI_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides (defaults: stable free-tier models, checked Nov 2026).
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_SMART=gemini-3.8-flash
# Optional caps on the shared free-tier quota (requests per day, per reader per day,
# and spacing between requests in ms).
AI_DAILY_LIMIT_FAST=1000
AI_DAILY_LIMIT_SMART=200
AI_USER_DAILY_LIMIT=300
AI_MIN_INTERVAL_MS=4000
# Your email or site, sent to Wikipedia/Wikidata with each lookup as their policy asks.
# Without it they allow 10 lookups a minute instead of 200.
WIKIMEDIA_CONTACT=

# ── Explore sources ─ Phase 5 ────────────────────────────────────────────────
# Free key: https://openalex.org (account settings → API key)
OPENALEX_API_KEY=
# Free key: https://core.ac.uk/services/api
CORE_API_KEY=
# Optional, raises rate limits: https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=

# ── Background jobs ─ Phase 5 ────────────────────────────────────────────────
# Any long random string; Vercel Cron sends it so only Vercel can trigger syncs.
CRON_SECRET=
